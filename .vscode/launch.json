{
    "version": "0.2.0",
    "configurations": [
         {
            "name":"Python Debugger: Current File (Ingestor)",
            "type":"debugpy",
            "request":"launch",
            "program":"${file}",
            "console":"integratedTerminal", 
            "justMyCode": true,
            "envFile": "${workspaceFolder}/ingestor/.env"
        },
        {
            "name":"Python Debugger: Current File (Benchmark)",
            "type":"debugpy",
            "request":"launch",
            "program":"${file}",
            "console":"integratedTerminal", 
            "justMyCode": true,
            "envFile": "${workspaceFolder}/benchmark/.env"
        },
        {
            "name": "Run Benchmark (Hyperparameter)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/benchmark/src/hyperparameter_runner.py",
            "args": [
                "-p",
                "${workspaceFolder}/benchmark/hyperparameters/hyperparameters-06c77f68-8fd7-11f0-9d35-2b5dd810f8be.json"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "envFile": "${workspaceFolder}/benchmark/.env"
        },
        {
            "name": "Run Ingestor",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/ingestor/src/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "envFile": "${workspaceFolder}/ingestor/.env"
        },
        {
            "name": "Debug FastAPI Server (Docker)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/server",
                    "remoteRoot": "/code/app"
                }
            ],
            "justMyCode": true
        },
        {
            "name": "Debug FastAPI Server (Docker - Wait)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/server",
                    "remoteRoot": "/code/app"
                }
            ],
            "justMyCode": true,
            "preLaunchTask": "Start Docker with Debug Wait"
        }
    ]
}
