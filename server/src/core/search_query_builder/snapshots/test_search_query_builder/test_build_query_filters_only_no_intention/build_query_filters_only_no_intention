
        SELECT
            searches.doi,
            sum(
                rrf_score(document_rank, 6) +
                rrf_score(chunk_rank, 6) +
                rrf_score(conditions_full_rank, 6) +
                rrf_score(conditions_partial_rank, 6) +
                rrf_score(keywords_rank, 6)
            ) AS overall_score,
            sum(rrf_score(document_rank, 6)) AS document_score,
            sum(rrf_score(chunk_rank, 6)) AS chunk_score,
            sum(rrf_score(conditions_full_rank, 6)) AS conditions_full_score,
            sum(rrf_score(conditions_partial_rank, 6)) AS conditions_partial_score,
            sum(rrf_score(keywords_rank, 6)) AS keywords_score
        FROM (
            -- Subquery 1: Document Similarity (title + summary (generated))
            (
                SELECT
                    NULL::text AS doi,
                    0 AS document_rank,
                    0 AS chunk_rank,
                    0 AS conditions_full_rank,
                    0 AS conditions_partial_rank,
                    0 AS keywords_rank
                WHERE FALSE -- Ensure this returns no rows
                LIMIT 0
            )
            UNION ALL
            -- Subquery 2: Chunk Similarity (title + text chunks)
            (
                SELECT
                    NULL::text AS doi,
                    0 AS document_rank,
                    0 AS chunk_rank,
                    0 AS conditions_full_rank,
                    0 AS conditions_partial_rank,
                    0 AS keywords_rank
                WHERE FALSE -- Ensure this returns no rows
                LIMIT 0
            )
            UNION ALL
            -- Subquery 3: Hard Filter Matches
            (
                
            WITH FilterFlags AS (
                -- Step 1: Calculate flags for each unique base condition per document using MAX(CASE WHEN ...)
                SELECT
                    f.document_id,
                    MAX(CASE WHEN f.key IN ('year') AND f.value_numeric > 2021 THEN 1 ELSE 0 END) AS "has_condition_1",
                    MAX(CASE
                        WHEN f.key IN ('journal') AND f.value ILIKE 'Science%' THEN 2
                        WHEN f.key IN ('journal') AND f.value ILIKE '%Science%' THEN 1
                        ELSE 0
                    END) AS "has_condition_2"
                FROM filter f
                -- Pre-filter rows based on all keys involved in the conditions
                WHERE f.key IN ('journal', 'year')
                GROUP BY f.document_id
            ),
            FilterLogic AS (
                -- Step 2: Apply the specific AND/OR logic and count partial matches
                SELECT
                    ff.document_id,
                    CASE
                        WHEN ("has_condition_1" > 0 AND "has_condition_2" > 0)
                        THEN 1 -- The document satisfies the overall logic (Full Match)
                        ELSE 0 -- The document does not satisfy the overall logic (Partial or No Match)
                    END AS conditions_full_score,
                    -- Sum of individual flags (scores can be 0, 1, or 2)
                    ("has_condition_1" + "has_condition_2") AS partial_match_count
                FROM FilterFlags ff
                -- Optimization: Only process documents that matched at least one flag based on score
                WHERE ("has_condition_1" > 0 OR "has_condition_2" > 0)
            )
            -- Step 3: Final SELECT, Ranking, and Join
            SELECT
                d.doi,
                0 AS document_rank,
                0 AS chunk_rank,
                fl.conditions_full_score AS conditions_full_rank, -- Treated as 1 (match) or 0 (no match); downstream scoring handles this.
                DENSE_RANK() OVER (ORDER BY fl.partial_match_count DESC) AS conditions_partial_rank,
                0 AS keywords_rank
            FROM FilterLogic fl
            JOIN document d ON d.id = fl.document_id
            WHERE partial_match_count > 0 -- Ensures only documents that truly matched (score > 0) are returned
            -- NO ORDER BY here, as we will use the rank to calculate the score
            -- NO LIMIT here, we want to get all documents that match the filter
            
            )
            UNION ALL
            -- Subquery 4: Keywords (Full-Text Search)
            (
                SELECT
                    d.doi,
                    0 AS document_rank,
                    0 AS chunk_rank,
                    0 AS conditions_full_rank,
                    0 AS conditions_partial_rank,
                    DENSE_RANK() OVER (ORDER BY ts_rank_cd(title_text_search_vector, to_tsquery('english', '')) DESC) AS keywords_rank
                FROM document d
                WHERE
                    '' != '' -- Avoid error if keywords are empty
                    AND title_text_search_vector @@ to_tsquery('english', '')
                -- NO ORDER BY here, as we will use the rank to calculate the score
                -- NO LIMIT here: we want all DOIs with at least one keyword match
            )
        ) searches
        WHERE searches.doi IS NOT NULL -- Exclude potential NULL DOIs from empty subqueries
        GROUP BY searches.doi
        ORDER BY
            overall_score DESC,
            conditions_full_score DESC,
            conditions_partial_score DESC,
            document_score DESC,
            chunk_score DESC,
            keywords_score DESC
        LIMIT 20;
        