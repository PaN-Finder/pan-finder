MAX(CASE WHEN f.key IN ('count') AND f.value_numeric = 5 THEN 1 ELSE 0 END) AS "has_condition_1"
MAX(CASE WHEN f.key IN ('score') AND f.value_numeric != 0.9 THEN 1 ELSE 0 END) AS "has_condition_2"
MAX(CASE WHEN f.key IN ('rating') AND f.value_numeric < 3.5 THEN 1 ELSE 0 END) AS "has_condition_3"
MAX(CASE WHEN f.key IN ('level') AND f.value_numeric <= 10 THEN 1 ELSE 0 END) AS "has_condition_4"
MAX(CASE WHEN f.key IN ('version') AND f.value_numeric >= 2 THEN 1 ELSE 0 END) AS "has_condition_5"