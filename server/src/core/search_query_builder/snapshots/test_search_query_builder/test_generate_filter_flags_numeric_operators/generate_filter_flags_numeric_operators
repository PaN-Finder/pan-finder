MAX(CASE WHEN f.key IN ('count') AND f.value_bigint = 5 THEN 1 ELSE 0 END) AS "has_condition_1"
MAX(CASE WHEN f.key IN ('score') AND f.value_float != 0.9 THEN 1 ELSE 0 END) AS "has_condition_2"
MAX(CASE WHEN f.key IN ('rating') AND f.value_float < 3.5 THEN 1 ELSE 0 END) AS "has_condition_3"
MAX(CASE WHEN f.key IN ('level') AND f.value_bigint <= 10 THEN 1 ELSE 0 END) AS "has_condition_4"
MAX(CASE WHEN f.key IN ('version') AND f.value_bigint >= 2 THEN 1 ELSE 0 END) AS "has_condition_5"