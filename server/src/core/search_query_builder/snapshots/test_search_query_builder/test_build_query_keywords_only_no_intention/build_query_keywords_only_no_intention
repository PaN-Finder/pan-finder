
        SELECT
            searches.doi,
            sum(
                rrf_score(document_rank, 6) +
                rrf_score(chunk_rank, 6) +
                rrf_score(conditions_full_rank, 6) +
                rrf_score(conditions_partial_rank, 6) +
                rrf_score(keywords_rank, 6)
            ) AS overall_score,
            sum(rrf_score(document_rank, 6)) AS document_score,
            sum(rrf_score(chunk_rank, 6)) AS chunk_score,
            sum(rrf_score(conditions_full_rank, 6)) AS conditions_full_score,
            sum(rrf_score(conditions_partial_rank, 6)) AS conditions_partial_score,
            sum(rrf_score(keywords_rank, 6)) AS keywords_score
        FROM (
            -- Subquery 1: Document Similarity (title + summary (generated))
            (
                SELECT
                    NULL::text AS doi,
                    0 AS document_rank,
                    0 AS chunk_rank,
                    0 AS conditions_full_rank,
                    0 AS conditions_partial_rank,
                    0 AS keywords_rank
                WHERE FALSE -- Ensure this returns no rows
                LIMIT 0
            )
            UNION ALL
            -- Subquery 2: Chunk Similarity (title + text chunks)
            (
                SELECT
                    NULL::text AS doi,
                    0 AS document_rank,
                    0 AS chunk_rank,
                    0 AS conditions_full_rank,
                    0 AS conditions_partial_rank,
                    0 AS keywords_rank
                WHERE FALSE -- Ensure this returns no rows
                LIMIT 0
            )
            UNION ALL
            -- Subquery 3: Hard Filter Matches
            (
                SELECT
                    NULL::text AS doi,
                    0 AS document_rank,
                    0 AS chunk_rank,
                    0 AS conditions_full_rank,
                    0 AS conditions_partial_rank,
                    0 AS keywords_rank
                WHERE FALSE -- Ensure this returns no rows
                LIMIT 0
            )
            UNION ALL
            -- Subquery 4: Keywords (Full-Text Search)
            (
                SELECT
                    d.doi,
                    0 AS document_rank,
                    0 AS chunk_rank,
                    0 AS conditions_full_rank,
                    0 AS conditions_partial_rank,
                    DENSE_RANK() OVER (ORDER BY ts_rank_cd(title_text_search_vector, to_tsquery('english', 'protein|folding|mechanism')) DESC) AS keywords_rank
                FROM document d
                WHERE
                    'protein|folding|mechanism' != '' -- Avoid error if keywords are empty
                    AND title_text_search_vector @@ to_tsquery('english', 'protein|folding|mechanism')
                -- NO ORDER BY here, as we will use the rank to calculate the score
                -- NO LIMIT here: we want all DOIs with at least one keyword match
            )
        ) searches
        WHERE searches.doi IS NOT NULL -- Exclude potential NULL DOIs from empty subqueries
        GROUP BY searches.doi
        ORDER BY
            overall_score DESC,
            conditions_full_score DESC,
            conditions_partial_score DESC,
            document_score DESC,
            chunk_score DESC,
            keywords_score DESC
        LIMIT 20;
        