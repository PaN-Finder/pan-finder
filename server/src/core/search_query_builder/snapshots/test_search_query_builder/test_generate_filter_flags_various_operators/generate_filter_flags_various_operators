MAX(CASE
                        WHEN (f.key IN ('title') AND f.value ILIKE 'Test Title%') THEN 2
                        WHEN (f.key IN ('title') AND f.value ILIKE '%Test Title%') THEN 1
                        ELSE 0
                    END) AS "has_condition_1"
MAX(CASE WHEN (f.key IN ('status') AND f.value NOT ILIKE '%draft%') THEN 1 ELSE 0 END) AS "has_condition_2"
MAX(CASE
                        WHEN (f.key IN ('tag') AND f.value ILIKE 'important%') THEN 2
                        WHEN (f.key IN ('tag') AND f.value ILIKE '%important%') THEN 1
                        ELSE 0
                    END) AS "has_condition_3"
MAX(CASE
                        WHEN (f.key IN ('label') AND f.value ILIKE 'urgent%') THEN 2
                        WHEN (f.key IN ('label') AND f.value ILIKE '%urgent%') THEN 1
                        ELSE 0
                    END) AS "has_condition_4"
MAX(CASE WHEN (f.key IN ('label') AND f.value NOT ILIKE '%old%') THEN 1 ELSE 0 END) AS "has_condition_5"
MAX(CASE WHEN (f.key IN ('category') AND f.value NOT ILIKE '%misc%') THEN 1 ELSE 0 END) AS "has_condition_6"
MAX(CASE WHEN (f.key IN ('count') AND cast_to_int(f.value) = 5) THEN 1 ELSE 0 END) AS "has_condition_7"
MAX(CASE WHEN (f.key IN ('score') AND cast_to_float(f.value) != 0.9) THEN 1 ELSE 0 END) AS "has_condition_8"
MAX(CASE WHEN (f.key IN ('rating') AND cast_to_float(f.value) < 3.5) THEN 1 ELSE 0 END) AS "has_condition_9"
MAX(CASE WHEN (f.key IN ('level') AND cast_to_int(f.value) <= 10) THEN 1 ELSE 0 END) AS "has_condition_10"
MAX(CASE WHEN (f.key IN ('version') AND cast_to_int(f.value) >= 2) THEN 1 ELSE 0 END) AS "has_condition_11"
MAX(CASE WHEN (f.key IN ('is_active') AND cast_to_bool(f.value) = true) THEN 1 ELSE 0 END) AS "has_condition_12"
MAX(CASE WHEN (f.key IN ('is_active') AND cast_to_bool(f.value) != false) THEN 1 ELSE 0 END) AS "has_condition_13"
MAX(CASE WHEN (f.key IN ('description') AND f.value IS NULL) THEN 1 ELSE 0 END) AS "has_condition_14"
MAX(CASE WHEN (f.key IN ('range') AND cast_to_float(f.value) NOT BETWEEN 100.5 AND 200.0) THEN 1 ELSE 0 END) AS "has_condition_15"
MAX(CASE WHEN (f.key IN ('ids') AND cast_to_int(f.value) NOT IN (1, 2, 3)) THEN 1 ELSE 0 END) AS "has_condition_16"
MAX(CASE WHEN (f.key IN ('mixed_in') AND cast_to_float(f.value) IN (1.0, 3.14)) THEN 1 ELSE 0 END) AS "has_condition_17"
MAX(CASE WHEN (f.key IN ('mixed_between') AND cast_to_float(f.value) BETWEEN 5.0 AND 15.5) THEN 1 ELSE 0 END) AS "has_condition_18"
MAX(CASE
                        WHEN (f.key IN ('alias1', 'alias2') AND f.value ILIKE 'shared%') THEN 2
                        WHEN (f.key IN ('alias1', 'alias2') AND f.value ILIKE '%shared%') THEN 1
                        ELSE 0
                    END) AS "has_condition_19"