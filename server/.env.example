LOG_LEVEL=INFO

# Database configuration
DATABASE_URL=postgresql://usr:pwd@pgvector:5432/pan-finder

# Database connection pool settings
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=20
DB_CONNECTION_TIMEOUT=30
DB_MAX_IDLE=300
DB_MAX_LIFETIME=3600

EMBEDDING_MODEL_PATH=/code/models/all-MiniLM-L12-v2

# Search engine settings
RRF_K_DOCUMENT=6
RRF_K_CHUNK=6
RRF_K_CONDITIONS_FULL=6
RRF_K_CONDITIONS_PARTIAL=6
RRF_K_KEYWORDS=10

# API configuration
API_HOST=0.0.0.0
API_PORT=8080

# CORS settings
ALLOWED_ORIGINS=*

# LLM provider selection: azure|openai
LLM_PROVIDER=azure

# Azure OpenAI configuration (used when LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# OpenAI compatible configuration (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

# Model names for specific tasks
DEFAULT_MODEL_NAME=gpt-4.1-mini
EXPLANATION_MODEL_NAME=gpt-4.1

# Cloudflare Turnstile settings
ENABLE_TURNSTILE=False
TURNSTILE_SECRET_KEY=""