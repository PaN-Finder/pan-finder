# Template for secret.yaml - copy this to secret.yaml and fill in actual values
# DO NOT commit the actual secret.yaml with real values to the repository

apiVersion: v1
kind: Secret
metadata:
  name: pgvector-secret
  namespace: pan-finder
  labels:
    app.kubernetes.io/name: pgvector
    app.kubernetes.io/component: database
type: Opaque
stringData:
  POSTGRES_PASSWORD: "your_postgres_password_here"
---
apiVersion: v1
kind: Secret
metadata:
  name: server-secret
  namespace: pan-finder
  labels:
    app.kubernetes.io/name: pan-finder-server
    app.kubernetes.io/component: api
type: Opaque
stringData:
  DATABASE_URL: "postgresql://usr:your_postgres_password_here@pgvector-service:5432/pan-finder"
  AZURE_OPENAI_ENDPOINT: "your_azure_openai_endpoint_here"
  AZURE_OPENAI_API_KEY: "your_azure_openai_api_key_here"
