REACT_APP_API=https://federated.panosc.ess.eu/api
REACT_APP_LIMIT=50

ESLINT_NO_DEV_ERRORS=true
DISABLE_ESLINT_PLUGIN=true

# Version information (set during build)
REACT_APP_VERSION=local-dev

# Umami analytics configuration
# Set REACT_APP_UMAMI_WEBSITE_ID to inject the Cloud Umami script at runtime
REACT_APP_UMAMI_WEBSITE_ID=

# Turnstile configuration
# Set to 'true' to enable Cloudflare Turnstile verification
# When disabled, users can search without human verification or session management
REACT_APP_ENABLE_TURNSTILE=false
REACT_APP_TURNSTILE_SITE_KEY=